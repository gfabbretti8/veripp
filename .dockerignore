# Everything the image does not need. Keeps the build context small and stops
# a local .venv (with host-absolute paths and host-arch binaries) from being
# baked into the image.
.git
.github
.venv
.pytest_cache
__pycache__
*.pyc
build/
dist/
*.egg-info
benchmarks/checkouts
benchmarks/results
demo/*/build
Dockerfile
.dockerignore

# The npx installer ships to npm, not into the image. The image already has
# veripp; carrying a script whose job is to install the skill elsewhere is
# dead weight in every layer.
package.json
npm/
