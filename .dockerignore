# Everything the image does not need. Keeps the build context small and stops
# a local .venv (with host-absolute paths and host-arch binaries) from being
# baked into the image.
.git
.github
.venv
.pytest_cache
__pycache__
*.pyc
build/
dist/
*.egg-info
benchmarks/checkouts
benchmarks/results
demo/*/build
Dockerfile
.dockerignore
